DISCORD_TOKEN=your-bot-token-here
GUILD_ID=your-server-id-here
CATEGORY_NAME=Personal Goals
RESULTS_CHANNEL_NAME=bot
TIMEZONE=America/Chicago

# Cron schedules, in the timezone above. Defaults: score just before
# midnight Saturday, post right at midnight Sunday. Score must fire before
# post - post overwrites the tracked message that score reads.
# For quick manual testing you don't need to touch these at all - use the
# !goals post / !goals score / !goals run chat commands instead. Only set
# these if you want the bot to auto-fire at a specific moment for a test.
SCORE_CRON=58 23 * * 6
POST_CRON=0 0 * * 0
